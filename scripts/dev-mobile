#!/usr/bin/env bash
set -Eeuo pipefail
project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ ! -x "$project_dir/api/.venv/bin/python" ]]; then
    echo '请先在项目根目录执行 uv sync --project api --frozen。' >&2
    exit 1
fi
exec "$project_dir/api/.venv/bin/python" "$project_dir/scripts/local_dev.py" mobile "$@"
